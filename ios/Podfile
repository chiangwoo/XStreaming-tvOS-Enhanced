# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# iOS 平台版本
platform :ios, '15.1'

# ============================================
# 禁用 New Architecture (Fabric) - 解决 react-native-screens codegen 问题
# RN 0.76.5 的 codegen 与 react-native-screens 4.x 不兼容
# ============================================
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'XStreaming' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # 禁用 Fabric (New Architecture)
    :fabric_enabled => false,
    # 启用 Hermes
    :hermes_enabled => true
  )

  target 'XStreamingTests' do
    inherit! :complete
    # Pods for testing
  end

  target 'XStreamingUITests' do
    inherit! :complete
    # Pods for UI testing
  end

  # ============================================
  # 修复 glog syscall tvOS 不兼容问题
  # glog 在 tvOS 上使用 syscall() 获取线程 ID，但 tvOS 禁用了 syscall
  # ============================================
  def fix_glog_for_tvos(installer)
    glog_utilities = File.join(installer.sandbox_root, 'Pods/glog/src/utilities.cc')
    glog_raw_logging = File.join(installer.sandbox_root, 'Pods/glog/src/raw_logging.cc')
    
    # 修复 utilities.cc
    if File.exist?(glog_utilities)
      content = File.read(glog_utilities)
      # 检查是否已经修复过
      unless content.include?('TARGET_OS_TV')
        # 替换 syscall(__NR_gettid) 为条件编译 (在 tvOS 上设为 -1)
        content = content.gsub(
          /pid_t tid = syscall\(__NR_gettid\);/,
          "#if !defined(TARGET_OS_TV) || !TARGET_OS_TV\npid_t tid = syscall(__NR_gettid);\n#else\npid_t tid = -1;\n#endif"
        )
        File.write(glog_utilities, content)
        Pod::UI.puts "✅ Fixed glog utilities.cc for tvOS"
      end
    end
    
    # 修复 raw_logging.cc
    if File.exist?(glog_raw_logging)
      content = File.read(glog_raw_logging)
      # 检查是否已经修复过
      unless content.include?('TARGET_OS_TV')
        # 替换 syscall(__NR_gettid) 为条件编译 (在 tvOS 上设为 -1)
        content = content.gsub(
          /pid_t tid = syscall\(__NR_gettid\);/,
          "#if !defined(TARGET_OS_TV) || !TARGET_OS_TV\npid_t tid = syscall(__NR_gettid);\n#else\npid_t tid = -1;\n#endif"
        )
        File.write(glog_raw_logging, content)
        Pod::UI.puts "✅ Fixed glog raw_logging.cc for tvOS"
      end
    end
  end

  # ============================================
  # 修复 React Native 0.76.5 Text 组件 tvOS 不兼容问题
  # RCTTextView 和 RCTUITextView 使用了 tvOS 不支持的 API
  # ============================================
  def fix_rn_text_for_tvos(installer)
    project_root = File.join(installer.sandbox_root, '..', '..', '..')
    rn_path = File.join(project_root, 'node_modules/react-native')
    
    unless File.exist?(rn_path)
      Pod::UI.puts "⚠️  node_modules/react-native not found, skipping RCTTextView fix"
      return
    end

    # 修复 RCTTextView.mm
    rct_text_view = File.join(rn_path, 'Libraries/Text/Text/RCTTextView.mm')
    if File.exist?(rct_text_view)
      content = File.read(rct_text_view)
      # 检查是否已经修复过
      unless content.include?('#if !TARGET_OS_TV') && content.include?('UIEditMenuInteractionDelegate')
        # 修复 interface 声明
        content = content.gsub(
          /@interface RCTTextView \(\) <UIEditMenuInteractionDelegate>/,
          "@interface RCTTextView () <UIEditMenuInteractionDelegate>\n@property (nonatomic, nullable) UIEditMenuInteraction *editMenuInteraction API_AVAILABLE(ios(16.0));\n@end\n\n#if TARGET_OS_TV\n@interface RCTTextView ()\n@end"
        )
        # 修复 enableContextMenu 方法
        content = content.gsub(
          /_editMenuInteraction = \[\[UIEditMenuInteraction alloc\] initWithDelegate:self\];/,
          "#if !TARGET_OS_TV\n    _editMenuInteraction = [[UIEditMenuInteraction alloc] initWithDelegate:self];\n    [self addInteraction:_editMenuInteraction];\n#endif"
        )
        # 修复 disableContextMenu 方法
        content = content.gsub(
          /\[self removeInteraction:_editMenuInteraction\];/,
          "#if !TARGET_OS_TV\n    [self removeInteraction:_editMenuInteraction];\n    _editMenuInteraction = nil;\n#endif"
        )
        # 修复 handleLongPress 方法中的 UIEditMenuInteraction
        content = content.gsub(
          /UIEditMenuConfiguration \*config = \[UIEditMenuConfiguration configurationWithIdentifier:nil sourcePoint:location\];/,
          "#if !TARGET_OS_TV\n    UIEditMenuConfiguration *config = [UIEditMenuConfiguration configurationWithIdentifier:nil sourcePoint:location];\n    if (_editMenuInteraction) {\n      [_editMenuInteraction presentEditMenuWithConfiguration:config];\n    }\n#endif"
        )
        # 修复 UIMenuController
        content = content.gsub(
          /UIMenuController \*menuController = \[UIMenuController sharedMenuController\];/,
          "#if !TARGET_OS_TV\n  UIMenuController *menuController = [UIMenuController sharedMenuController];\n\n  if (menuController.isMenuVisible) {\n    return;\n  }\n\n  [menuController showMenuFromView:self rect:self.bounds];\n#endif"
        )
        # 修复 UIPasteboard
        content = content.gsub(
          /UIPasteboard \*pasteboard = \[UIPasteboard generalPasteboard\];/,
          "#if !TARGET_OS_TV\n  UIPasteboard *pasteboard = [UIPasteboard generalPasteboard];\n  pasteboard.items = @[ item ];\n#endif"
        )
        File.write(rct_text_view, content)
        Pod::UI.puts "✅ Fixed RCTTextView.mm for tvOS"
      end
    end

    # 修复 RCTUITextView.mm
    rct_uitext_view = File.join(rn_path, 'Libraries/Text/TextInput/Multiline/RCTUITextView.mm')
    if File.exist?(rct_uitext_view)
      content = File.read(rct_uitext_view)
      # 检查是否已经修复过
      unless content.include?('#if !TARGET_OS_TV') && content.include?('scrollsToTop')
        content = content.gsub(
          /self\.scrollsToTop = NO;/,
          "#if !TARGET_OS_TV\n    self.scrollsToTop = NO;\n#endif"
        )
        File.write(rct_uitext_view, content)
        Pod::UI.puts "✅ Fixed RCTUITextView.mm for tvOS"
      end
    end
  end
  
  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # 修复 glog tvOS 问题
    fix_glog_for_tvos(installer)
    
    # 修复 React Native Text 组件 tvOS 问题
    fix_rn_text_for_tvos(installer)
    
    # tvOS 部署目标配置
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # iOS 部署目标
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        
        # tvOS 部署目标（用于跨平台库）
        if config.build_settings['TVOS_DEPLOYMENT_TARGET']
          config.build_settings['TVOS_DEPLOYMENT_TARGET'] = '15.1'
        end
        
        # 针对 tvOS 的特殊配置
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'TARGET_OS_TV=1'
        
        # 禁用某些仅 iOS 的特性
        if target.name.include?('CoreMotion') || 
           target.name.include?('Battery') ||
           target.name.include?('Haptic')
          config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'YES'
        end
      end
    end
  end

end
